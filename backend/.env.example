# OpenRouter
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_X_TITLE=ERR-App

# Strict model requirements
OPENROUTER_CHAT_MODEL=qwen/qwen3.5-35b-a3b
# Simple tasks (translation, HyDE, QA generation) use lighter model
OPENROUTER_CHAT_MODEL_SIMPLE=qwen/qwen3.5-35b-a3b
# Complex tasks (multi-query expansion, LLM rerank) use more capable model
OPENROUTER_CHAT_MODEL_COMPLEX=qwen/qwen3.5-122b-a10b
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b
OPENROUTER_EMBEDDING_DIM=4096

# ERR settings
ERR_SESSION_TTL_SECONDS=1800
ERR_SESSION_CLEANUP_INTERVAL_SECONDS=30
ERR_CHUNK_TARGET_TOKENS=512
ERR_CHUNK_OVERLAP_TOKENS=50
ERR_SEMANTIC_CHUNKING_ENABLED=false
ERR_SEMANTIC_CHUNKING_THRESHOLD=0.5
ERR_SEMANTIC_CHUNKING_MAX_SENTENCES=2000

# Embedding query behavior (optional)
# Qwen3-Embedding is instruction-aware; enabling instructions typically improves retrieval.
ERR_EMBEDDING_QUERY_USE_INSTRUCTION=true
ERR_EMBEDDING_QUERY_INCLUDE_RAW=true
ERR_EMBEDDING_QUERY_INSTRUCTION_TEMPLATE="Instruct: {task}\nQuery: {query}"
ERR_EMBEDDING_QUERY_TASK="Given a question, retrieve relevant passages from the document that explicitly contain the answer."
# Fast mode: include raw query embedding in addition to instruction embedding
# Keep false by default for lower latency/cost.
ERR_FAST_MODE_INCLUDE_RAW_QUERY=false
# Fast mode embedding aggregation decay (earlier inputs have higher weight)
ERR_FAST_MODE_EMBEDDING_AGGREGATION_DECAY=0.7

# Local semantic chunking (SentenceTransformers) download/proxy controls
# Set ERR_HF_PROXY to point at your proxy (e.g. http://127.0.0.1:10808)
# Use ERR_HF_DISABLE_SSL_VERIFY=true only if your proxy MITM breaks SSL.
# Prefer ERR_HF_CA_BUNDLE if your proxy provides a custom CA cert.
ERR_HF_PROXY=
ERR_HF_HOME=
ERR_HF_CA_BUNDLE=
ERR_HF_DISABLE_SSL_VERIFY=false

# Context re-packing (ordering of retrieved chunks in the prompt)
# - reverse: put most relevant chunk near the end of CONTEXT (default)
# - forward: keep retrieval order (no re-packing)
ERR_REPACK_STRATEGY=reverse
# Include prev/next chunk neighbors in answer CONTEXT.
ERR_CONTEXT_INCLUDE_NEIGHBORS=true
# Fast mode can disable neighbors to reduce prompt size and latency.
ERR_FAST_MODE_INCLUDE_NEIGHBORS=false
# Keep only the latest N chat turns in prompt history (0 disables history).
ERR_CHAT_HISTORY_MAX_TURNS=12
# Additional hard cap for history text size in prompt.
ERR_CHAT_HISTORY_MAX_CHARS=6000
# Guard against accidental answer carry-over from previous turns.
ERR_ANSWER_REPEAT_GUARD_ENABLED=true
# If current answer is very similar to previous answer (>= threshold) while
# current query is not similar to previous query (<= threshold), force one retry.
ERR_ANSWER_REPEAT_ANSWER_SIMILARITY_MIN=0.9
ERR_ANSWER_REPEAT_QUERY_SIMILARITY_MAX=0.6

# Recall-oriented retrieval (Multi-Query + HyDE + RRF)
ERR_QUERY_FUSION_ENABLED=true
ERR_QUERY_VARIANTS_COUNT=6
ERR_QUERY_VARIANTS_MAX=8
ERR_HYDE_ENABLED=true
ERR_HYDE_MAX_WORDS=140

# Query drift filtering (keeps recall, drops obvious off-topic variants)
ERR_DRIFT_FILTER_ENABLED=true
ERR_DRIFT_SIM_THRESHOLD=0.25
ERR_HYDE_DRIFT_SIM_THRESHOLD=0.15

# Fusion params
ERR_RRF_K=60
ERR_FUSION_PER_QUERY_TOP_K=50
ERR_FUSION_MAX_CANDIDATES=120
# Bound concurrent per-query retrieval searches in normal mode.
ERR_RETRIEVAL_PARALLELISM=4
# Retriever candidate pool defaults
ERR_RETRIEVER_CANDIDATE_K=100
ERR_FAST_MODE_CANDIDATE_K=50

# LLM rerank (yes/no judge; uses ERR_LLM_RERANK_MODEL or falls back to OPENROUTER_CHAT_MODEL_COMPLEX)
ERR_LLM_RERANK_ENABLED=true
ERR_LLM_RERANK_MODEL=
ERR_LLM_RERANK_CANDIDATE_POOL=30
ERR_LLM_RERANK_MAX_CHARS=900

# Fast mode defaults
# Set true if you still want translation in fast mode.
ERR_FAST_MODE_LANGUAGE_ALIGNMENT=false

# Approximate token limit guard (tune as needed)
ERR_CHAT_MODEL_CONTEXT_LIMIT_TOKENS=32768
